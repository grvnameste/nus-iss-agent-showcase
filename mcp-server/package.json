{
  "name": "@eduagent/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "EduAgent Connect MCP server — exposes approved capabilities to compatible MCP clients by reusing the backend business services. No duplicated business logic.",
  "main": "dist/mcp-server/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/mcp-server/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  }
}
