# EduAgent Connect — Nginx reverse proxy (single instance).
#
# Serves the Next.js client (:3000), Express API (:4000), and the MCP HTTP
# endpoint (:4100) on one origin, so the browser hits one host and there is no
# CORS. Copy to /etc/nginx/sites-available/eduagent, set your host, enable it,
# test, reload, then run certbot for TLS (see deploy/README.md).
#
# No custom domain? Register a free DuckDNS subdomain (https://www.duckdns.org)
# pointed at your Lightsail STATIC IP, e.g. eduagent.duckdns.org.
# (Alternatively, a no-signup nip.io host: <dashed-ip>.nip.io.)
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/eduagent
#   sudo ln -s /etc/nginx/sites-available/eduagent /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d eduagent.duckdns.org   # ← your DuckDNS host

server {
    listen 80;
    listen [::]:80;
    server_name eduagent.duckdns.org;   # ← your DuckDNS host (certbot rewrites for TLS)

    # Agent turns can carry large request bodies; keep the proxy from rejecting
    # them (a common cause of 413s behind proxies/WAFs).
    client_max_body_size 25m;

    # Backend REST API.
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # MCP server — Streamable HTTP transport (Spec 17). Remote MCP clients
    # (e.g. MCP Inspector) connect to https://<host>/mcp (your DuckDNS host).
    # SSE streams must not be buffered, and turns can run long, so buffering is
    # off and read timeouts are generous.
    location /mcp {
        proxy_pass http://127.0.0.1:4100;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-Sent Events: stream to the client, don't buffer.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Next.js client (everything else).
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
