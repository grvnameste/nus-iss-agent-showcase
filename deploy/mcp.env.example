# EduAgent Connect — MCP server environment (Lightsail / production, Spec 17)
# Copy to mcp-server/.env and edit. Never commit the real .env.
#
# The MCP server reuses the backend business services in-process, so it needs no
# API base URL and no secrets. It exposes the same seven tools over the network
# via the Streamable HTTP transport. Writes stay FAIL-CLOSED: submit_enquiry is
# refused because no human-approval channel is wired for remote clients yet.

# Runtime
NODE_ENV=production
LOG_LEVEL=info

# Transport: `http` exposes a network endpoint; `stdio` is the local default.
MCP_TRANSPORT=http

# Bind to loopback; Nginx terminates TLS and proxies https://<host>/mcp here.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=4100

# DNS-rebinding protection. When either list is non-empty, protection is ENABLED
# and only these Host/Origin values may drive the endpoint.
#
# No custom domain? Register a free subdomain at https://www.duckdns.org and
# point it at your Lightsail STATIC IP, e.g. `eduagent.duckdns.org`.
# (Alternatively, a no-signup nip.io host: <dashed-ip>.nip.io.)
# This MUST match the hostname clients actually connect through (the Nginx
# server_name and the client's public URL), or requests are rejected.
MCP_ALLOWED_HOSTS=eduagent.duckdns.org
MCP_ALLOWED_ORIGINS=https://eduagent.duckdns.org
