# EduAgent Connect — server environment (Lightsail / production)
# Copy to server/.env and edit. Never commit the real .env.

# Runtime
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# CORS: the deployed client origin(s), comma-separated. Served same-origin behind
# Nginx, so this is just the public host. Never use "*" here.
#
# No custom domain? Register a free DuckDNS subdomain (https://www.duckdns.org)
# pointed at your Lightsail STATIC IP, e.g. https://eduagent.duckdns.org.
CORS_ORIGIN=https://eduagent.duckdns.org

# Enquiry persistence (Spec 16) — SQLite file on the instance disk.
# ENQUIRY_STORE=sqlite persists; use a DURABLE path so data survives restarts.
ENQUIRY_STORE=sqlite
ENQUIRY_DB_PATH=/home/ubuntu/eduagent/data/enquiries.db
