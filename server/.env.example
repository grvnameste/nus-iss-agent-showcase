# EduAgent Connect — Server environment example
# Copy to .env and adjust as needed. Do NOT commit .env.

# Port the Express API listens on
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (frontend URL).
# Use "*" only for local prototyping.
CORS_ORIGIN=http://localhost:3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
